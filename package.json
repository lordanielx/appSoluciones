{
  "name": "mecaelectric-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @meca/shared build && pnpm -r --parallel --filter @meca/api --filter @meca/web --filter @meca/shared dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "db:migrate": "pnpm --filter @meca/api db:migrate",
    "db:deploy": "pnpm --filter @meca/api db:deploy",
    "db:seed": "pnpm --filter @meca/api db:seed",
    "db:reset": "pnpm --filter @meca/api db:reset",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "argon2", "sharp", "esbuild", "@swc/core", "@nestjs/core"]
  }
}
