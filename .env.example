# ------------------------------------------------------------------
# Mecaelectric Operaciones — variables de entorno
# Copiar a .env (nunca subir .env al repositorio).
# ------------------------------------------------------------------
# NODE_ENV lo define cada comando (la API usa development por defecto)

# --- API ---
API_PORT=3000
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
# URL pública de la aplicación web (enlaces de recuperación de contraseña)
APP_PUBLIC_URL=http://localhost:5173
# URL pública de la API (URLs firmadas del driver local)
API_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
# Intentos por minuto e IP en login/recuperación
AUTH_RATE_LIMIT_PER_MINUTE=10
# Número de proxies de confianza (X-Forwarded-For) delante de la API
TRUST_PROXY=0

# --- Base de datos ---
DATABASE_URL=postgresql://meca:meca@localhost:5432/mecaelectric?schema=public

# --- Autenticación ---
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-dev-access-secret-min-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Cookies Secure: true en staging/producción (HTTPS)
COOKIE_SECURE=false

# --- Storage ---
# s3 (MinIO / S3 compatible) o local (disco, URLs firmadas por la API)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mecaelectric
S3_ACCESS_KEY=mecaminio
S3_SECRET_KEY=mecaminio-dev-secret
S3_FORCE_PATH_STYLE=true
# Endpoint público para URLs firmadas (si difiere del interno, p. ej. en Docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000
LOCAL_STORAGE_DIR=./storage-data
# Secreto HMAC para URLs firmadas del driver local
STORAGE_SIGNING_SECRET=change-me-dev-storage-signing-secret
SIGNED_URL_TTL_SECONDS=900

# --- PDF ---
# Ruta opcional al ejecutable de Chromium. Vacío = el Chromium de Playwright.
PDF_CHROMIUM_PATH=

# --- Correo (recuperación de contraseña) ---
# Vacío = el enlace se registra en el log (solo desarrollo)
SMTP_URL=
MAIL_FROM="Mecaelectric Operaciones <no-reply@mecaelectric.local>"

# --- MinIO (docker compose) ---
MINIO_ROOT_USER=mecaminio
MINIO_ROOT_PASSWORD=mecaminio-dev-secret

# --- Postgres (docker compose) ---
POSTGRES_USER=meca
POSTGRES_PASSWORD=meca
POSTGRES_DB=mecaelectric
